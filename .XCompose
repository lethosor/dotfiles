# https://askubuntu.com/a/47528
# defaults in /usr/share/X11/locale/en_US.UTF-8/Compose
# reload with `ibus restart`
include "%L"   # import the default Compose file for your locale

<Multi_key> <v> <minus> : "√"

<Multi_key> <equal> <equal> : "≡"
<Multi_key> <equal> <minus> : "≡"
<Multi_key> <minus> <equal> : "≡"
<Multi_key> <equal> <asciitilde> : "≅"
<Multi_key> <asciitilde> <equal> : "≅"
