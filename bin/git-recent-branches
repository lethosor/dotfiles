#!/usr/bin/env python
import argparse
import subprocess
import sys
import time
from pathlib import Path


def common_gitdir():
    out = subprocess.check_output(
        ["git", "rev-parse", "--git-common-dir"], text=True
    ).strip()
    return Path(out)


def latest_reflog_timestamp(path):
    last = ""
    with path.open() as f:
        for line in f:
            if line.strip():
                last = line
    if not last:
        return None
    header = last.split("\t", 1)[0]
    parts = header.split()
    try:
        return int(parts[-2])
    except (ValueError, IndexError):
        return None


def collect_branches():
    logs_dir = common_gitdir() / "logs" / "refs" / "heads"
    if not logs_dir.is_dir():
        return []
    latest = {}
    for path in logs_dir.rglob("*"):
        if not path.is_file():
            continue
        ts = latest_reflog_timestamp(path)
        if ts is None:
            continue
        branch = str(path.relative_to(logs_dir))
        latest[branch] = ts
    return sorted(latest.items(), key=lambda kv: kv[1], reverse=True)


def describe_time_ago(diff):
    diff = max(0, int(diff))
    units = [
        (60, 1, "second"),
        (3600, 60, "minute"),
        (86400, 3600, "hour"),
        (86400 * 14, 86400, "day"),
        (86400 * 70, 86400 * 7, "week"),
        (86400 * 365, 86400 * 30, "month"),
    ]
    for threshold, divisor, unit in units:
        if diff < threshold:
            n = diff // divisor
            return f"{n} {unit}{'' if n == 1 else 's'} ago"
    n = diff // (86400 * 365)
    return f"{n} year{'' if n == 1 else 's'} ago"


def main():
    parser = argparse.ArgumentParser(description="List recently active branches")
    parser.add_argument(
        "-n",
        "--limit",
        type=int,
        default=20,
        help="number of branches to show (default: 20; <=0 shows all branches with a reflog)",
    )
    args = parser.parse_args()

    now = int(time.time())
    branches = collect_branches()
    if args.limit > 0:
        branches = branches[: args.limit]
    for branch, ts in branches:
        sys.stdout.write(
            f" \033[33m{describe_time_ago(now - ts)}: \033[32m\033[1m{branch}\033[0m\n"
        )


if __name__ == "__main__":
    main()
