#!/usr/bin/env python
import argparse
import re
import subprocess
import sys
import time

CHECKOUT_RE = re.compile(
    r"^HEAD@\{(?P<timestamp>\d+)\} checkout: moving from \S+ to (?P<branch>\S+)$"
)


def worktree_paths():
    out = subprocess.check_output(["git", "worktree", "list", "--porcelain"], text=True)
    search_prefix = "worktree "
    return [
        line[len(search_prefix) :]
        for line in out.splitlines()
        if line.startswith(search_prefix)
    ]


def reflog_lines(worktree):
    result = subprocess.run(
        [
            "git",
            "-C",
            worktree,
            "reflog",
            "show",
            "--date=unix",
            "--pretty=format:%gd %gs",
        ],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        return []
    return result.stdout.splitlines()


def collect_branches():
    latest = {}
    for wt in worktree_paths():
        for line in reflog_lines(wt):
            m = CHECKOUT_RE.match(line)
            if not m:
                continue
            ts = int(m.group("timestamp"))
            branch = m.group("branch")
            if ts > latest.get(branch, -1):
                latest[branch] = ts
    return sorted(latest.items(), key=lambda kv: kv[1], reverse=True)


def describe_time_ago(diff):
    diff = max(0, int(diff))
    units = [
        (60, 1, "second"),
        (3600, 60, "minute"),
        (86400, 3600, "hour"),
        (86400 * 14, 86400, "day"),
        (86400 * 70, 86400 * 7, "week"),
        (86400 * 365, 86400 * 30, "month"),
    ]
    for threshold, divisor, unit in units:
        if diff < threshold:
            n = diff // divisor
            return f"{n} {unit}{'' if n == 1 else 's'} ago"
    n = diff // (86400 * 365)
    return f"{n} year{'' if n == 1 else 's'} ago"


def main():
    parser = argparse.ArgumentParser(description="List recently checked-out branches")
    parser.add_argument(
        "-n",
        "--limit",
        type=int,
        default=20,
        help="number of branches to show (default: 20; <=0 shows all branches still present in the reflog)",
    )
    args = parser.parse_args()

    now = int(time.time())
    branches = collect_branches()
    if args.limit > 0:
        branches = branches[: args.limit]
    for branch, ts in branches:
        sys.stdout.write(
            f" \033[33m{describe_time_ago(now - ts)}: \033[32m\033[1m{branch}\033[0m\n"
        )


if __name__ == "__main__":
    main()
